{
  "provider": "hybrid",
  "answer_base_url": "http://192.168.0.28:8001",
  "answer_timeout_seconds": 30,
  "daily_token_cap": 10000000,
  "warning_token_cap": 7000000,
  "feature_token_caps": {
    "companion_dialogue": 1000000,
    "companion_free_chat": 5000000,
    "companion_guide": 4000000,
    "guide_embedding": 200000,
    "mob_dialogue": 100000,
    "event_news": 30000,
    "manual_test": 20000
  },
  "model_aliases": {
    "small-dialogue": {
      "provider_model": "openai/gpt-4.1-nano",
      "features": ["companion_dialogue", "companion_free_chat"],
      "max_output_tokens": 120,
      "temperature": 0.4
    },
    "local-small-dialogue": {
      "provider_model": "openai_compatible/local-gemma-4-e4b-it",
      "features": ["companion_dialogue", "companion_free_chat"],
      "max_output_tokens": 100,
      "temperature": 0.2
    },
    "gemini-small-dialogue": {
      "provider_model": "gemini/gemini-2.5-flash-lite",
      "features": ["companion_dialogue", "companion_free_chat"],
      "max_output_tokens": 120,
      "temperature": 0.4
    },
    "openai-small-guide": {
      "provider_model": "openai/gpt-4.1-nano",
      "features": ["companion_guide"],
      "max_output_tokens": 300,
      "temperature": 0.2
    },
    "local-small-guide": {
      "provider_model": "openai_compatible/local-gemma-4-e4b-it",
      "features": ["companion_guide"],
      "max_output_tokens": 180,
      "temperature": 0.2
    },
    "gemini-guide-answer": {
      "provider_model": "gemini/gemini-2.5-flash-lite",
      "features": ["companion_guide"],
      "max_output_tokens": 300,
      "temperature": 0.2
    }
  },
  "fallback_aliases": {
    "small-dialogue": ["local-small-dialogue", "gemini-small-dialogue"],
    "openai-small-guide": ["local-small-guide", "gemini-guide-answer"]
  },
  "unmetered_provider_prefixes": ["openai_compatible/"],
  "guide_answer_fallback_alias": "local-small-guide",
  "guide_embedding_provider": "openai_compatible",
  "guide_embedding_base_url_env": "OPENDAOC_RAG_EMBEDDING_BASE_URL",
  "guide_embedding_model": "text-embedding-nomic-embed-text-v1.5",
  "guide_embedding_dimensions": 768,
  "guide_embedding_batch_size": 1000,
  "guide_embedding_timeout_seconds": 120,
  "guide_top_k": 5,
  "guide_context_token_budget": 6000,
  "rag_database_url_env": "OPENDAOC_RAG_DATABASE_URL",
  "usage_log": "test-output/ai-gateway/hybrid-openai-local-usage.jsonl",
  "ledger_file": "test-output/ai-gateway/hybrid-openai-local-ledger.json",
  "cache_file": "test-output/ai-gateway/hybrid-openai-local-dialogue-cache.jsonl",
  "cache_enabled": true,
  "cache_limit": 20000
}
